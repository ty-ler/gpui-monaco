; Foldable regions: each node folds from its first line to the line before
; its closing bracket.
[
  (block)
  (declaration_list)
  (field_declaration_list)
  (ordered_field_declaration_list)
  (enum_variant_list)
  (match_block)
  (use_list)
  (token_tree)
  (arguments)
  (parameters)
  (field_initializer_list)
  (array_expression)
  (block_comment)
] @fold
