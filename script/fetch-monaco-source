#!/usr/bin/env bash
# Sparse-clones VS Code's editor sources (Monaco's real source tree) into the
# gitignored vendor/vscode directory, for reading and porting tests.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
dest="$root/vendor/vscode"
if [ -d "$dest/.git" ]; then
  git -C "$dest" pull --quiet --depth 1
else
  git clone --quiet --depth 1 --filter=blob:none --sparse https://github.com/microsoft/vscode.git "$dest"
fi
git -C "$dest" sparse-checkout set src/vs/editor src/vs/base/common
echo "vscode @ $(git -C "$dest" rev-parse --short HEAD) in $dest"
